    "start_time_label": "1:30"
   },
   {
    "start_ms": 93240,
    "end_ms": 96000,
    "snippet": "1/4 कप डालना उसको आते में धीरे-धीरे करके",
    "start_time_text": "1:33",
    "start_time_label": "1:33"
   },
   {
    "start_ms": 96000,
    "end_ms": 98700,
    "snippet": "मिलना ताकि ऐसा ना हो की आता नरम लग जाए",
    "start_time_text": "1:36",
    "start_time_label": "1:36"
   },
   {
    "start_ms": 98700,
    "end_ms": 102110,
    "snippet": "आता थोड़ा सख्त होना चाहिए इसका",
