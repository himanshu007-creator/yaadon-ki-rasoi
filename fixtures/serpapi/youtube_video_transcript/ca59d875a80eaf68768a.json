    "start_time_label": "1:04"
   },
   {
    "start_ms": 68100,
    "end_ms": 68840,
    "snippet": "मिलना",
    "start_time_text": "1:08",
    "start_time_label": "1:08"
   },
   {
    "start_ms": 68840,
    "end_ms": 70500,
    "snippet": "[संगीत]",
    "start_time_text": "1:08",
    "start_time_label": "1:08"
   },
   {
    "start_ms": 70500,
    "end_ms": 73020,
    "snippet": "आप देख सकते हो की मैं तो सिर्फ घी के साथ",
    "start_time_text": "1:10",
    "start_time_label": "1:10"
   },
   {
    "start_ms": 73020,
    "end_ms": 76020,
    "snippet": "ही मिलने लग गया है पूरा बिल्कुल इसको ऐसे",
    "start_time_text": "1:13",
    "start_time_label": "1:13"
   },
   {
    "start_ms": 76020,
    "end_ms": 79200,
    "snippet": "मिलना है दूसरी बात जो आते में ध्यान रखनी",
    "start_time_text": "1:16",
    "start_time_label": "1:16"
   },
   {
    "start_ms": 79200,
    "end_ms": 82140,
    "snippet": "बहुत जरूरी है और ये है की ये जो आता है",
    "start_time_text": "1:19",
    "start_time_label": "1:19"
   },
   {
    "start_ms": 82140,
    "end_ms": 84659,
    "snippet": "इसमें पानी बहुत कम होता है बहुत मतलब",
    "start_time_text": "1:22",
    "start_time_label": "1:22"
   },
   {
    "start_ms": 84659,
    "end_ms": 87000,
    "snippet": "बहुत ही कम होता है अब क्वांटिटी deoge तो",
