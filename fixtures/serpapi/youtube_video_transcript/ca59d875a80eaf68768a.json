  "transcript": [
   {
    "start_ms": 0,
    "end_ms": 2879,
    "snippet": "होली का टाइम हो और घर पर गुजिया ना बने",
    "start_time_text": "0:00",
    "start_time_label": "0:00"
   },
   {
    "start_ms": 2879,
    "end_ms": 5940,
    "snippet": "ऐसा करना तो पाप से कम नहीं है तो इस होली",
    "start_time_text": "0:02",
    "start_time_label": "0:02"
   },
   {
    "start_ms": 5940,
    "end_ms": 7980,
    "snippet": "पे आप एक गुजिया की रेसिपी ट्री करके",
    "start_time_text": "0:05",
    "start_time_label": "0:05"
   },
   {
    "start_ms": 7980,
    "end_ms": 10440,
    "snippet": "देखना आपकी जितनी dikkatein हैं गुजिया",
    "start_time_text": "0:07",
    "start_time_label": "0:07"
   },
   {
    "start_ms": 10440,
    "end_ms": 13559,
    "snippet": "बनाने में जैसे की गुजिया का टूटना खस्ता",
    "start_time_text": "0:10",
    "start_time_label": "0:10"
   },
   {
    "start_ms": 13559,
    "end_ms": 15719,
    "snippet": "ना बन्ना ये सारी dikkatein सॉल्व हो",
    "start_time_text": "0:13",
    "start_time_label": "0:13"
   },
   {
    "start_ms": 15719,
    "end_ms": 17699,
    "snippet": "जाएंगी इस वीडियो से आप इसको एक बार ट्राई",
    "start_time_text": "0:15",
    "start_time_label": "0:15"
   },
   {
    "start_ms": 17699,
    "end_ms": 22460,
    "snippet": "करके देखना होली पर आपको बहुत पसंद आएगी",
    "start_time_text": "0:17",
    "start_time_label": "0:17"
   },
   {
    "start_ms": 23760,
    "end_ms": 25980,
    "snippet": "हेलो दोस्तों मैं हूं भारत और आपका स्वागत",
    "start_time_text": "0:23",
    "start_time_label": "0:23"
   },
   {
    "start_ms": 25980,
    "end_ms": 28140,
    "snippet": "है भारत किचन हिंदी में तो फिर देर किस",
    "start_time_text": "0:25",
    "start_time_label": "0:25"
   },
   {
    "start_ms": 28140,
    "end_ms": 30439,
    "snippet": "बात की चलो फिर शुरू करते हैं",
    "start_time_text": "0:28",
    "start_time_label": "0:28"
   },
   {
    "start_ms": 30439,
    "end_ms": 33239,
    "snippet": "अब गुजिया बनाने के लिए सबसे पहले तो आता",
    "start_time_text": "0:30",
    "start_time_label": "0:30"
   },
   {
    "start_ms": 33239,
    "end_ms": 35820,
    "snippet": "लगाना पड़ेगा तो मैं तो यहां पर काफी सारी",
    "start_time_text": "0:33",
    "start_time_label": "0:33"
   },
   {
    "start_ms": 35820,
    "end_ms": 37440,
    "snippet": "गुजिया बना रहा हूं तो इसलिए मैंने यहां",
    "start_time_text": "0:35",
    "start_time_label": "0:35"
   },
   {
    "start_ms": 37440,
    "end_ms": 40379,
    "snippet": "पर आधा किलो मैदा लिया है आधे किलो मेड",
    "start_time_text": "0:37",
    "start_time_label": "0:37"
   },
   {
    "start_ms": 40379,
    "end_ms": 44520,
    "snippet": "में आपने 125 ग्राम 14 टाइम्स इसलिए मैंने",
    "start_time_text": "0:40",
    "start_time_label": "0:40"
   },
   {
    "start_ms": 44520,
    "end_ms": 47640,
    "snippet": "बोला 125 ग्राम या आधा कप देसी घी आपने",
    "start_time_text": "0:44",
    "start_time_label": "0:44"
   },
   {
    "start_ms": 47640,
    "end_ms": 50219,
    "snippet": "डालना है ध्यान रहे गीत जमा हुआ भी नहीं",
    "start_time_text": "0:47",
    "start_time_label": "0:47"
   },
   {
    "start_ms": 50219,
    "end_ms": 52699,
    "snippet": "होना चाहिए और एकदम",
    "start_time_text": "0:50",
    "start_time_label": "0:50"
   },
   {
    "start_ms": 52699,
    "end_ms": 55739,
    "snippet": "वीडियो होना चाहिए बिल्कुल ऐसे तो आपने",
    "start_time_text": "0:52",
    "start_time_label": "0:52"
   },
   {
    "start_ms": 55739,
    "end_ms": 58920,
    "snippet": "आधा कप पूरा भरकर ही डालना है और जो सबसे",
    "start_time_text": "0:55",
    "start_time_label": "0:55"
   },
   {
    "start_ms": 58920,
    "end_ms": 61379,
    "snippet": "इंपॉर्टेंट चीज है जो लोग गुजिया में गलत",
    "start_time_text": "0:58",
    "start_time_label": "0:58"
   },
   {
    "start_ms": 61379,
    "end_ms": 64439,
    "snippet": "कर देते हैं वो ये है ही को मेड में अच्छे",
    "start_time_text": "1:01",
    "start_time_label": "1:01"
   },
   {
    "start_ms": 64439,
    "end_ms": 68100,
    "snippet": "से नहीं मिलते तो अब घी को मैंने अच्छे से",
