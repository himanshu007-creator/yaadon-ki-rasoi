    "start_time_label": "2:57"
   },
   {
    "start_ms": 179400,
    "end_ms": 181260,
    "snippet": "है उनको घी में थोड़ी देर के लिए भून लेना",
    "start_time_text": "2:59",
    "start_time_label": "2:59"
   },
   {
    "start_ms": 181260,
    "end_ms": 183540,
    "snippet": "और थोड़ी देर के बाद जैसे ही इनमें",
