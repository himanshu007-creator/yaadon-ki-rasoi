  "steps": {
   "videoId": "fIebwiemcV8",
   "title": "Sooji Mawa Gujiya | बिना फालतू मेहनत हलवाई जैसी खस्ता गुजिया बनाने का तरीका |Holi Special Gujiya",
   "channel": "bharatzkitchen HINDI",
   "mode": "verbatim",
   "ingredients": [],
   "steps": [
    {
     "n": 1,
     "startMs": 0,
     "text": "होली का टाइम हो और घर पर गुजिया ना बने ऐसा करना तो पाप से कम नहीं है तो इस होली पे…"
    },
    {
     "n": 2,
     "startMs": 68100,
     "text": "मिलना आप देख सकते हो की मैं तो सिर्फ घी के साथ ही मिलने लग गया है पूरा बिल्कुल इसको ऐसे मिलना…"
    },
    {
     "n": 3,
     "startMs": 130860,
     "text": "से मल लेना आप देख सकते हो की आता बिल्कुल भी एवं नहीं है यह कहीं से लग ही नहीं रहा की…"
    },
    {
     "n": 4,
     "startMs": 194580,
     "text": "इसी घी में मैंने अब यहां पर कोकोनट बनाना है यानी की सूखा नारियल घिसा हुआ वह भुनाना है तो इसी घी…"
    },
    {
     "n": 5,
     "startMs": 255900,
     "text": "में जाने के लिए अच्छा अब लास्ट स्टेप रहता है तो मैंने कढ़ाई को अच्छे साफ कर लिया है और कढ़ाई को…"
    },
    {
     "n": 6,
     "startMs": 322199,
     "text": "मैंने गरम कोई में ही डाली है लास्ट चीज आपने डालनी है सूजी भुनी हुई सूजी आप यहां पर डालना और उसको…"
    },
    {
     "n": 7,
     "startMs": 386639,
     "text": "तो एक-एक करके मैंने ऐसे सारे पेड़े रख ली है बना के और अब आपको इसको बेलने की भी तकनीक बता देता…"
    }
   ]
  },
