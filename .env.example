# Server-only. Never prefix with NEXT_PUBLIC_.
SERPAPI_API_KEY=
# replay | live | hybrid. Defaults to replay when SERPAPI_API_KEY is empty.
DEMO_MODE=
# Hard cap on live SerpApi credits per IST day.
DAILY_CREDIT_CAP=40
# Live investigations allowed per IP per day (cache hits are free and unlimited).
PER_IP_LIVE_PER_DAY=2
# Optional. Without it, a deterministic parser/extractor is used.
ANTHROPIC_API_KEY=
# Set to 1 to save every live SerpApi response as a redacted fixture.
RECORD=
# Optional: your custom domain (e.g. https://yaadonkirasoi.in). On Vercel the production URL is used automatically.
SITE_URL=
# Optional. Cartesia TTS for the grandmother voices on the map (npm run voices).
CARTESIA_API_KEY=
# Public deploy mode: the server's SerpApi key is never used for searches; visitors paste their own
# (stored only in their browser). Without one they see the recorded investigations.
NEXT_PUBLIC_VERCEL_DEPLOY=
